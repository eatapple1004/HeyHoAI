{
  "name": "heyhoai",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:staging": "NODE_ENV=staging node src/db/migrate.js",
    "migrate:dev": "NODE_ENV=development node src/db/migrate.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "deploy": "bash deploy/deploy.sh prod",
    "deploy:staging": "bash deploy/deploy.sh staging",
    "deploy:dev": "bash deploy/deploy.sh dev",
    "pm2:start": "pm2 start ecosystem.config.js --only heyhoai",
    "pm2:start:staging": "pm2 start ecosystem.config.js --only heyhoai-staging",
    "pm2:start:dev": "pm2 start ecosystem.config.js --only heyhoai-dev",
    "pm2:stop": "pm2 stop heyhoai",
    "pm2:restart": "pm2 restart heyhoai",
    "pm2:logs": "pm2 logs heyhoai",
    "pm2:status": "pm2 status",
    "build": "tsc -p tsconfig.json",
    "start:nest": "node dist/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@google/genai": "^1.48.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@zernio/node": "^0.2.157",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^6.38.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
