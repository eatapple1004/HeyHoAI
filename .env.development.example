# ── dev (로컬) 환경 설정 예시 ──
# 사용: 이 파일을 `.env.development` 로 복사 후 값 채우기. (NODE_ENV=development 로 실행 시 자동 로드)
#   cp .env.development.example .env.development
# ⚠️ 로컬은 반드시 로컬 DB를 볼 것 — 운영 DATABASE_URL 절대 금지.

NODE_ENV=development
PORT=3000

# 로컬 Postgres (docker compose up -d 로 띄운 DB)
DATABASE_URL=postgresql://doppia:doppia@localhost:5432/doppia_dev

# 로컬은 prod 잡을 이중 폴링하면 안 되므로 폴러 OFF 권장
DISABLE_VIDEO_POLLER=true
COOKIE_SECURE=false

# 필수 시크릿(로컬 임의값 가능)
JWT_SECRET=local-dev-secret-change-me-0000
ADMIN_EMAIL=admin@heyhoai.local
ADMIN_PASSWORD=localdevadmin123

# 개발에 필요한 프로바이더 키만 채우면 됨(없으면 해당 기능만 비활성)
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# FAL_API_KEY=
# KLING_ACCESS_KEY=
# ... (전체 키 목록은 .env.example 참고)

# 결제는 로컬에서 sandbox/비활성 권장
# EXIMBAY_ENV=test
# PORTONE_ENABLED=false
