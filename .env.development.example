# ── dev 환경 설정 예시 (AWS dev.doppia.ai) ──
# 사용: dev 클론(~/HeyHoAI-dev)에서 `.env.development` 로 복사 후 값 채우기.
#   cp .env.development.example .env.development
# dev는 현재 EC2에서 포트 3002 + 별도 DB(doppia_dev) + dev.doppia.ai 로 동작(develop 브랜치).
# ⚠️ prod와 DB·시크릿을 절대 공유하지 말 것. 결제는 반드시 테스트/sandbox.

NODE_ENV=development
PORT=3002

# 같은 EC2의 Postgres, 별도 데이터베이스(로컬접속 → SSL off 자동 처리)
DATABASE_URL=postgresql://<db_user>:<db_pass>@localhost:5432/doppia_dev

PUBLIC_URL=https://dev.doppia.ai
COOKIE_SECURE=true
# dev도 자체 폴러 운영(단, prod/staging와 DB가 달라 잡 충돌 없음)
DISABLE_VIDEO_POLLER=false

# 시크릿은 prod/staging과 다른 값으로
JWT_SECRET=<dev-전용-32자-이상-시크릿>
ADMIN_EMAIL=admin@doppia.ai
ADMIN_PASSWORD=<dev-admin-비번-12자이상>

# 결제 = 테스트/sandbox
EXIMBAY_ENV=test
PORTONE_ENABLED=false
# 자동결제(빌링). 계약·채널이 준비된 환경에서만 켠다 — 상세 주석은 .env.example 참조.
PORTONE_BILLING_CHANNEL_KEY=
PORTONE_BILLING_ENABLED=
# 구독 정기청구 스케줄러. 'on'일 때만 기동하며 **실청구가 발생**한다.
#   ⚠️ 전 환경 통틀어 한 곳에서만 켤 것. 테스트 채널에서는 켜지 말 것.
BILLING_SCHEDULER=

MARKETPLACE_PAID=false

# 프로바이더 키(운영과 별개 키 권장 — 비용/쿼터 격리)
ANTHROPIC_API_KEY=
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=dev/images
# ... (전체 키 목록은 .env.example 참고)

# ────────────────────────────────────────────────────────────
# (참고) 순수 로컬 개발용으로 쓸 경우엔 아래처럼 바꿔 쓰면 됨:
#   PORT=3000 · COOKIE_SECURE=false · PUBLIC_URL 생략 · DISABLE_VIDEO_POLLER=true
#   DATABASE_URL=postgresql://doppia:doppia@localhost:5432/doppia_dev  (docker compose)
