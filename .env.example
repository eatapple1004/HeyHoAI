# Server
PORT=3000
NODE_ENV=development

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
# 역할별로 나눠 쓴다. base=정형작업(캡션·캐릭터), 나머지 둘은 품질 우선이라 상위 모델로 override.
#   전부 같게 두면 통일된다. 미설정 시 base=sonnet-5 / 대본·enhance=opus-4-8.
# ⚠️ 값을 비워두면(KEY=) 빈 문자열이 들어가 기본값이 안 먹는다 — 안 쓸 거면 줄째로 주석 처리할 것.
# ⚠️ 모델 ID를 여기 박아두면 그 모델이 은퇴할 때 조용히 404가 된다(실제로 claude-sonnet-4-20250514가
#    2026-06-15 은퇴하며 세 환경의 AI 캡션이 두 달간 죽어 있었다). 특별한 이유가 없으면 주석인 채로 두고
#    src/config의 기본값을 따라간다.
# CLAUDE_MODEL=          # 캡션·캐릭터(정형)
# CLAUDE_MODEL_SCRIPT=   # UGC 대본 생성 — 템플릿 저작 수준이라 품질 영향이 크다
# CLAUDE_MODEL_ENHANCE=  # 프롬프트 Enhance — 결과 이미지 품질에 직결

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heyhoai

# Auth (JWT + 쿠키)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
# 마이그레이션 시 기존 데이터를 이관할 기본 관리자 계정
ADMIN_EMAIL=admin@heyhoai.local
# 12자 이상의 강력한 비밀번호로 반드시 설정 (예: `openssl rand -base64 24`). 미설정/약한 값이면 부팅 실패.
ADMIN_PASSWORD=__set_a_strong_password_min_12_chars__
# 프로덕션 HTTPS 도메인 환경에서는 true (Cloudflare/HTTPS 적용 후)
COOKIE_SECURE=false

# 외부 공개 주소 (도메인). HTTPS 적용 후 설정 — 인스타 발행 미디어 URL·발행 링크에 사용.
# 예: PUBLIC_URL=https://doppia.ai  (미설정 시 폴백 IP 사용)
PUBLIC_URL=

# Google OAuth (소셜 로그인). Google Cloud Console > API/서비스 > 사용자 인증 정보 >
# OAuth 2.0 클라이언트 ID(웹) 생성. 승인된 리디렉션 URI에 아래 콜백을 등록:
#   https://doppia.ai/api/auth/google/callback  (운영)
#   http://localhost:3000/api/auth/google/callback  (로컬)
# 미설정 시 Google 로그인 비활성(버튼 클릭 시 'not configured' 안내).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (선택) redirect_uri 직접 지정. 미설정 시 PUBLIC_URL(또는 요청 host)+/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Image Providers (최소 하나 필요)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxx
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
FAL_API_KEY=fal_xxxxxxxxxxxxxxxxxx
FAL_MODEL=fal-ai/flux/dev
# Seedance(ByteDance) 영상 — fal 경유. standard(1080p까지) | fast(720p까지) | reference(제품+아바타)
SEEDANCE_TIER=standard
# Google Gemini (Standard/HD 사진). Google AI Studio에서 발급.
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxx
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Video Providers (최소 하나 필요)
RUNWAY_API_KEY=key_xxxxxxxxxxxxxxxxxx
RUNWAY_MODEL=gen4_turbo
# Kling (이미지→비디오 릴스). access/secret 키 쌍으로 JWT 서명.
KLING_ACCESS_KEY=kling_access_xxxxxxxxxxxx
KLING_SECRET_KEY=kling_secret_xxxxxxxxxxxx
KLING_MODEL=kling-v2
MINIMAX_API_KEY=minimax_xxxxxxxxxxxxxxxxxx
MINIMAX_MODEL=video-01

# OpenAI (GPT Image)
OPENAI_API_KEY=sk-proj-xxxxxxxxxx

# Publishing (Zernio / Instagram)
ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxxxx

# Publishing (Meta 직결 — Instagram Business Login) · /admin-business-meta 에서 사용
#   ⚠️ INSTAGRAM_APP_ID는 Meta 앱 ID와 **다른 숫자**다 — Meta 앱 → Instagram → API 설정에 따로 있다.
#   리디렉션 URI는 Meta 콘솔 등록값과 완전히 같아야 하고 **HTTPS**여야 한다(인스타는 http를 거절).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://dev.doppia.ai/api/admin/business-meta/oauth/callback

# Billing — Lemon Squeezy (크레딧 팩 결제)
# https://app.lemonsqueezy.com/settings/api 에서 API 키 발급
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Settings > Webhooks 에서 https://<도메인>/api/billing/webhook 등록 후 시크릿 입력
LEMONSQUEEZY_WEBHOOK_SECRET=
# 스토어에 만든 크레딧 팩 상품(Product→Variant)의 variant ID.
# ⚠️ 변수명은 레거시(PACK50/120/300/700)지만 실제 매핑은 아래와 같다(pricing.config.js 기준).
# LS 상품 가격을 반드시 아래 USD와 동일하게 만들 것:
#   LS_VARIANT_PACK50  → pack9   = $9   (◈3,400)
#   LS_VARIANT_PACK120 → pack49  = $49  (◈19,200)
#   LS_VARIANT_PACK300 → pack199 = $199 (◈79,500)
#   LS_VARIANT_PACK700 → pack349 = $349 (◈142,000)
LS_VARIANT_PACK50=
LS_VARIANT_PACK120=
LS_VARIANT_PACK300=
LS_VARIANT_PACK700=

# Billing — Eximbay (해외/국내 카드 PG, 가맹점 계약 후)
# 심사 통과 후 발급받은 값 입력. EXIMBAY_ENV=test 로 먼저 테스트.
EXIMBAY_API_KEY=
EXIMBAY_MID=
EXIMBAY_ENV=test

# Billing — PortOne V2 (국내 원화 카드 결제. 크레딧 팩 결제창의 **1순위** PG)
# 세 값이 모두 있어야 활성화된다. 하나라도 비면 결제창이 조용히 Eximbay → Lemon Squeezy로 넘어간다.
#   (어느 조건에서 넘어갔는지는 브라우저 콘솔의 `[billing] PortOne 건너뜀` 로그로 확인)
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
# 임시 킬스위치. false/0/off/no 를 넣으면 **키가 다 있어도** PortOne을 끈다
# (PG 심사 대기 중 Lemon Squeezy 브릿지를 우선시키려고 만든 값 — 심사 통과 후엔 비워두거나 true).
PORTONE_ENABLED=

# ── 자동결제(빌링/정기결제) ──
# ⚠️ 일반결제(승인)와 **PG 계약이 별개**다. 토스 등 PG에 자동결제를 따로 신청·심사받아야 하고,
#    승인되면 PortOne 콘솔에도 **빌링 전용 채널**이 따로 생긴다. 일반결제 채널로 빌링키를 발급하면
#    PG가 "자동 결제(빌링) 계약이 안 되어 있습니다"로 거절하고, 그때 뜨는 PortOne 자체 에러창은
#    닫기 버튼이 동작하지 않아 사용자가 새로고침 말곤 빠져나올 수 없다.
# 비워두면 PORTONE_CHANNEL_KEY로 폴백하지만, 아래 ENABLED가 기본 꺼짐이라 실제로 쓰이진 않는다.
PORTONE_BILLING_CHANNEL_KEY=
# 자동결제 계약이 실제로 승인된 뒤에만 true/1/on/yes. 기본(빈값)=꺼짐 → 구독·카드등록 UI가 열리지 않는다.
PORTONE_BILLING_ENABLED=

# ── 구독 정기청구 스케줄러 ──
# 'on' 일 때만 기동한다(그 외 값·미설정 = 꺼짐). 매시간 만기 구독을 찾아 **실제로 카드를 청구**한다.
# ⚠️ 켜는 환경은 반드시 **한 곳**이어야 한다. 여러 프로세스에서 켜면 같은 구독을 동시에 청구하려 든다
#    (subscription_charges의 (subscription_id, period_start) 유니크가 이중청구는 막지만, 애초에 하나만 켤 것).
# ⚠️ PortOne이 아직 **테스트 채널**이면 켜지 말 것 — 실청구가 안 되는 채널로 재청구가 돌아 구독이
#    실패 처리(던닝 3회 후 past_due)될 수 있다. 실채널 전환 후에 켠다.
# ⚠️ 새 키를 추가할 땐 src/config/index.js의 zod 스키마에도 선언해야 한다.
#    선언하지 않으면 zod가 걸러내 env에서 사라져 "켰는데 안 켜지는" 조용한 실패가 된다(실제로 겪음).
BILLING_SCHEDULER=

# 구독 플랜 판매 노출. 'false' 면 가격표에서 구독 섹션이 숨겨진다(기본 = 노출).
SUBSCRIPTIONS_FOR_SALE=


# ── 미디어 오브젝트 스토리지 (S3 호환: AWS S3 / Cloudflare R2) ──
# ⚠️ 운영에서 실제로 쓰는 값이다. 미설정이면 생성물이 로컬 tmp/images에만 남고,
#    재배포·프로세스 재시작 때 사라져 갤러리가 404가 된다(그래서 R2를 붙였다).
# MEDIA_S3_BUCKET 이 활성화 스위치 — 비우면 전부 로컬 동작.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-northeast-2          # EC2와 같은 리전 권장(서울)
MEDIA_S3_ENDPOINT=                      # R2 등 S3 호환 커스텀 엔드포인트. 순정 S3면 비움
MEDIA_S3_PUBLIC_BASE=                   # 공개 CDN/버킷 URL (예: https://cdn.doppia.ai). 없으면 앱이 프록시 스트리밍
MEDIA_S3_PREFIX=images                  # 버킷 내 키 접두사
# 자격증명은 표준 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY 또는 EC2 인스턴스 프로파일(IAM Role)에서 자동 해석.

# ── ElevenLabs (UGC 오디오 — TTS 음성 + 배경음악. 한 키로 둘 다) ──
# ⚠️ 운영에서 실제로 쓰는 값이다. 미설정 시 음성은 OpenAI TTS로 폴백하고 **음악은 아예 빠진다**(무음악).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=n2fbxG88jqAoaVPUy3IG   # 기본 Yooni(한국어 원어민). 영상별로 스튜디오에서 override
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_MUSIC_MODEL=music_v2            # music_v1 | music_v2(라이선스 클리어)

# ── UGC 자막 ──
# 자막 번인 폰트(libass). **한글 글리프가 있는 폰트여야 한다** — 없으면 □□□ 두부박스가 찍힌다.
#   서버에 fonts-noto-cjk 설치 필요. 패밀리명이 다르면 이 값으로 override.
UGC_SUBTITLE_FONT=
UGC_CAPTIONS_ENABLED=                      # 'false'면 자막 번인 끔(기본 켜짐)

# ── 운영 스위치 ──
# 마켓 유료 과금 게이트. false면 유저가 만든 유료 템플릿이 실제 크레딧을 돌리지 않는다.
#   공식 시드(is_official)는 이 값과 무관하게 항상 유료다.
MARKETPLACE_PAID=false
# 영상 잡 폴러 끄기(로컬 개발용). 로컬이 prod DB에 붙으면 폴러가 prod 잡을 이중 폴링해
#   중복 finalize·attempts 부풀림이 생긴다. 로컬 프로세스만 true.
DISABLE_VIDEO_POLLER=false

# ── On Model faceswap (facefusion 워커) ──
# 미설정 시 ~/facefusion · CPU 기본값으로 동작한다. 화질 튜닝값은 실측으로 정해진 것이라
#   함부로 바꾸지 말 것(상세 근거 = src/config/index.js 주석 · docs/onmodel_품질개선_다음세션.md).
FACEFUSION_DIR=                          # facefusion 설치 경로(기본 ~/facefusion)
FACEFUSION_PYTHON=                       # venv python(기본 <dir>/venv/bin/python)
FACEFUSION_MODEL=inswapper_128           # simswap/hyperswap은 정체성 드리프트가 있어 inswapper 유지
FACEFUSION_PROVIDERS=cpu                 # cpu / coreml / cuda (콤마구분)
FACEFUSION_PIXEL_BOOST=512x512           # 고픽셀 재처리. 빈값이면 끔
FACEFUSION_FACE_ENHANCER=                # 기본 OFF — 켜면 얼굴만 밝고 매끈해져 몸과 "뜬다"
FACEFUSION_FACE_ENHANCER_BLEND=80
FACEFUSION_OUTPUT_QUALITY=100
FACEFUSION_COMBO=                        # '1'/'true'면 스왑 2회 + 주파수합성(시간 2배, 선명도↑)
FACEFUSION_COMBO_ENHANCER=gpen_bfr_1024
FACEFUSION_COMBO_DETAIL_SWAPPER=
FACEFUSION_COMBO_BLEND=80
FACEFUSION_COMBO_RADIUS=12
FACEFUSION_COMBO_GAIN=1
FACEFUSION_MASK_BLUR=                    # 스왑 경계 페더링 0~1. ↑=턱·목 이음새가 부드러워짐
FACEFUSION_MASK_TYPES=                   # 공백구분(예 "box occlusion"). occlusion=머리카락 가림 처리
FACEFUSION_TIMEOUT_MS=120000             # 이미지당 하드 타임아웃(좀비 방지)
FACEFUSION_CONCURRENCY=1                 # 동시 실행 캡. 메모리 빠듯한 서버에서 올리지 말 것
FACESWAP_POLL_MS=5000                    # 워커 큐 폴링 유휴 간격
