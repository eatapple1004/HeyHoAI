# ── staging (sta) 환경 설정 예시 ──
# 사용: EC2에서 이 파일을 `.env.staging` 으로 복사 후 값 채우기.
#   cp .env.staging.example .env.staging
# staging은 prod와 같은 EC2에서 포트 3001 + 별도 DB(doppia_staging) + staging.doppia.ai 로 동작.
# ⚠️ prod와 DB·시크릿을 절대 공유하지 말 것. 결제는 반드시 테스트/sandbox 키.

NODE_ENV=staging
PORT=3001

# 같은 EC2의 Postgres, 별도 데이터베이스(로컬접속이라 SSL off — db/client 자동 처리)
DATABASE_URL=postgresql://<db_user>:<db_pass>@localhost:5432/doppia_staging

PUBLIC_URL=https://staging.doppia.ai
COOKIE_SECURE=true
DISABLE_VIDEO_POLLER=false

# 시크릿은 prod와 다른 값으로(유출 시 격리)
JWT_SECRET=<staging-전용-32자-이상-시크릿>
ADMIN_EMAIL=admin@doppia.ai
ADMIN_PASSWORD=<staging-admin-비번-12자이상>

# 결제 = 테스트/sandbox (실결제 방지)
EXIMBAY_ENV=test
PORTONE_ENABLED=false
# 자동결제(빌링). 계약·채널이 준비된 환경에서만 켠다 — 상세 주석은 .env.example 참조.
PORTONE_BILLING_CHANNEL_KEY=
PORTONE_BILLING_ENABLED=
# 구독 정기청구 스케줄러. 'on'일 때만 기동하며 **실청구가 발생**한다.
#   ⚠️ 전 환경 통틀어 한 곳에서만 켤 것. 테스트 채널에서는 켜지 말 것.
BILLING_SCHEDULER=

MARKETPLACE_PAID=false

# 프로바이더 키(운영과 별개 키 권장 — 비용/쿼터 격리)
ANTHROPIC_API_KEY=
# 미디어 스토리지도 staging 전용 버킷/prefix 권장
# MEDIA_S3_BUCKET=
# MEDIA_S3_PREFIX=staging/images
# ... (전체 키 목록은 .env.example 참고)
